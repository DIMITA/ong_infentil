# ──────────────────────────────────────────────
# Application
# ──────────────────────────────────────────────
APP_NAME="ONG Infentil"
APP_ENV=production
APP_KEY=                          # générer : php artisan key:generate
APP_DEBUG=false
APP_URL=https://votre-domaine.org
APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ──────────────────────────────────────────────
# Database — PostgreSQL (service Docker : db)
# ──────────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=ong_infentil
DB_USERNAME=ong_user
DB_PASSWORD=CHANGER_CE_MOT_DE_PASSE

# ──────────────────────────────────────────────
# Session / Cache / Queue
# ──────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
CACHE_STORE=database
QUEUE_CONNECTION=database

# ──────────────────────────────────────────────
# Cloudflare R2 (stockage médias)
# ──────────────────────────────────────────────
FILESYSTEM_DISK=r2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=ong-infentil
AWS_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
AWS_USE_PATH_STYLE_ENDPOINT=true

# ──────────────────────────────────────────────
# Email — Brevo SMTP
# ──────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="contact@ong-infentil.org"
MAIL_FROM_NAME="${APP_NAME}"

# ──────────────────────────────────────────────
# KKiaPay (paiement mobile Afrique de l'Ouest)
# ──────────────────────────────────────────────
KKIAPAY_PUBLIC_KEY=
KKIAPAY_PRIVATE_KEY=
KKIAPAY_SECRET=
KKIAPAY_SANDBOX=false

# ──────────────────────────────────────────────
# Donorbox (dons internationaux)
# ──────────────────────────────────────────────
DONORBOX_CAMPAIGN_URL=

# ──────────────────────────────────────────────
# Ports Nginx (optionnel — défaut : 80 / 443)
# ──────────────────────────────────────────────
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
